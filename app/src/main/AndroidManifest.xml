<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (no-op below API 30). The LAUNCHER intent lets the
         caregiver pick any app with an icon; without it Messenger and Facebook
         were invisible on Android 11+ and their tiles never appeared. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.viber.voip" />
        <package android:name="com.facebook.orca" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.aurora.store" />
        <package android:name="com.android.vending" />
        <package android:name="com.android.launcher3" />
        <package android:name="com.google.android.apps.photos" />
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android-dir/mms-sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Elder">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Elder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FavouritesActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />
        <activity
            android:name=".ContactsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />



        <activity
            android:name=".CallsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />

        <activity
            android:name=".CameraActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />

        <activity
            android:name=".AppPickerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CaregiverActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elder" />
    </application>
</manifest>
